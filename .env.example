# Postgres. Local docker compose default, or paste a Neon/Supabase/RDS URL.
DATABASE_URL=postgres://boardyn:boardyn@localhost:5432/boardyn

# Any long random string. Used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Where this instance is reachable. Used to build Google OAuth redirect URIs.
APP_URL=http://localhost:3000

# Google Calendar sync (optional). Create an OAuth client of type "Web application"
# at https://console.cloud.google.com/apis/credentials and add the redirect URI
# {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: require a bearer token on /api/cron/sync
CRON_SECRET=
